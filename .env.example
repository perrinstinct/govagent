# govagent configuration. Copy to .env and fill in. Every variable uses the GOVAGENT_ prefix.

# --- LLM (Amazon Bedrock) ---
# Model or inference-profile ID, e.g. an Anthropic Claude model available in your region.
GOVAGENT_MODEL_ID=
GOVAGENT_AWS_REGION=
# USD per million tokens, from the AWS Bedrock pricing page for GOVAGENT_MODEL_ID.
GOVAGENT_PRICE_INPUT_PER_MTOK=
GOVAGENT_PRICE_OUTPUT_PER_MTOK=

# --- Ruleset and linter ---
GOVAGENT_RULESET_PATH=rulesets/governance.spectral.yaml
GOVAGENT_RULES_META_PATH=rulesets/rules_meta.yaml
GOVAGENT_SPECTRAL_BIN=spectral

# --- Budgets (enforced in code) ---
GOVAGENT_MAX_ATTEMPTS_PER_GROUP=3
GOVAGENT_MAX_LLM_CALLS_PER_RUN=40
GOVAGENT_MAX_COST_USD_PER_RUN=0.50

# --- GitHub ---
GOVAGENT_GITHUB_TOKEN=
# Comma-separated OWNER/NAME list. Any other repository is refused.
GOVAGENT_REPO_ALLOWLIST=

# --- MCP server ---
GOVAGENT_MCP_API_KEY=
GOVAGENT_ANALYSIS_TTL_SECONDS=3600

# --- Observability ---
GOVAGENT_LOG_LEVEL=INFO
# Optional Langfuse tracing: enabled when both keys are set.
GOVAGENT_LANGFUSE_PUBLIC_KEY=
GOVAGENT_LANGFUSE_SECRET_KEY=
GOVAGENT_LANGFUSE_HOST=
