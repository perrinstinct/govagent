[10.976, "o", "\u001b[1m[aa564a113eab-1] gov-servers-https at /servers\u001b[0m\r\nReplace the http:// scheme with https:// in the sandbox server URL while preserving the host, port, path, and any server variables unchanged.\r\n\u001b[1m--- a/spec\u001b[0m\r\n"]
[10.976, "o", "\u001b[1m+++ b/spec\u001b[0m\r\n"]
[10.976, "o", "\u001b[36m@@ -10,5 +10,5 @@\u001b[0m\r\n"]
[10.976, "o", "   - url: https://api.petstore.example.com/v2\r\n"]
[10.976, "o", "     description: Production\r\n"]
[10.976, "o", "\u001b[31m-  - url: http://sandbox.petstore.example.com/v2\u001b[0m\r\n"]
[10.976, "o", "\u001b[32m+  - url: https://sandbox.petstore.example.com/v2\u001b[0m\r\n"]
[10.976, "o", "     description: Sandbox\r\n"]
[10.976, "o", " security:\r\n"]
[10.976, "o", "Apply this fix? [y/N]:"]
[10.976, "o", " "]
[13.576, "o", "y\r\n"]
[13.576, "o", "\r\n\u001b[1m[23d608c07c43-1] gov-operation-summary at /paths/~1pets/get\u001b[0m\r\n"]
[13.576, "o", "Added a concise imperative summary \"List pets\" (2 words) to the GET /pets operation, derived from the operation's description and method.\r\n"]
[13.576, "o", "\u001b[1m--- a/spec\u001b[0m\r\n\u001b[1m+++ b/spec\u001b[0m\r\n"]
[13.576, "o", "\u001b[36m@@ -20,4 +20,5 @@\u001b[0m\r\n   /pets:\r\n     get:\r\n"]
[13.576, "o", "\u001b[32m+      summary: List pets\u001b[0m\r\n"]
[13.576, "o", "       description: Returns a page of pets, newest first.\r\n"]
[13.576, "o", "       operationId: listPets\r\n"]
[13.576, "o", "Apply this fix? [y/N]: "]
[16.176, "o", "y\r\n"]
[16.176, "o", "\r\n\u001b[1m[f81d7202532f-1] gov-operation-tags at /paths/~1pets/get\u001b[0m\r\n"]
[16.176, "o", "The GET /pets operation is missing a required tag. The tag \"pets\" already exists in the root tags list and matches the resource name (first static path segment), so it is reused without adding a duplicate.\r\n\u001b[1m--- a/spec\u001b[0m\r\n\u001b[1m+++ b/spec\u001b[0m\r\n"]
[16.176, "o", "\u001b[36m@@ -20,4 +20,6 @@\u001b[0m\r\n"]
[16.176, "o", "   /pets:\r\n"]
[16.176, "o", "     get:\r\n"]
[16.176, "o", "\u001b[32m+      tags:\u001b[0m\r\n"]
[16.176, "o", "\u001b[32m+        - pets\u001b[0m\r\n"]
[16.176, "o", "       summary: List pets\r\n       description: Returns a page of pets, newest first.\r\n"]
[16.176, "o", "Apply this fix? [y/N]: "]
[18.776, "o", "y\r\n"]
[18.776, "o", "\r\n\u001b[1m[750cf4c5fa50-1] gov-error-response at /paths/~1pets~1{petId}/get\u001b[0m\r\nThis is a single-resource lookup operation (GET /pets/{petId}), so it should return a 404 response when the pet is not found. A NotFound response already exists in components/responses, so we reference it.\r\n"]
[18.776, "o", "\u001b[1m--- a/spec\u001b[0m\r\n"]
[18.776, "o", "\u001b[1m+++ b/spec\u001b[0m\r\n"]
[18.776, "o", "\u001b[36m@@ -73,4 +73,6 @@\u001b[0m\r\n"]
[18.776, "o", "               schema:\r\n"]
[18.776, "o", "                 $ref: \"#/components/schemas/Pet\"\r\n"]
[18.776, "o", "\u001b[32m+        '404':\u001b[0m\r\n"]
[18.776, "o", "\u001b[32m+          $ref: '#/components/responses/NotFound'\u001b[0m\r\n"]
[18.776, "o", "     delete:\r\n"]
[18.776, "o", "       tags: [pets]\r\n"]
[18.776, "o", "Apply this fix? [y/N]: "]
[21.376, "o", "y\r\n"]
[21.376, "o", "\r\n\u001b[1m[d43719b032c5-1] gov-path-kebab at /paths\u001b[0m\r\n"]
[21.376, "o", "\u001b[37m\u001b[41m\u001b[1m BREAKING \u001b[0m\r\nRename the path key from /petOwners/{ownerId}/pets to /pet-owners/{ownerId}/pets to convert the static segment \"petOwners\" to kebab-case \"pet-owners\", while preserving the path parameter {ownerId} unchanged.\r\n"]
[21.376, "o", "\u001b[1m--- a/spec\u001b[0m\r\n"]
[21.376, "o", "\u001b[1m+++ b/spec\u001b[0m\r\n"]
[21.376, "o", "\u001b[36m@@ -85,5 +85,5 @@\u001b[0m\r\n"]
[21.376, "o", "         \"404\":\r\n"]
[21.376, "o", "           $ref: \"#/components/responses/NotFound\"\r\n"]
[21.376, "o", "\u001b[31m-  /petOwners/{ownerId}/pets:\u001b[0m\r\n"]
[21.376, "o", "\u001b[32m+  /pet-owners/{ownerId}/pets:\u001b[0m\r\n     get:\r\n"]
[21.376, "o", "       tags: [owners]\r\n"]
[21.376, "o", "Apply this fix? [y/N]:"]
[21.376, "o", " "]
